# --- Database connection ---
# Primary (Supabase Cloud — direct connection, port 5432).
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string → URI → "Direct connection"
# Replace [YOUR-PASSWORD] with the database password set when you created the project.
# Wrap the value in single quotes if your password contains shell-special characters.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# Test database. Recommended: a *separate* Supabase project (free tier allows multiple).
# Pytest TRUNCATEs trending_videos between every test, so do NOT point this at your dev DB.
TEST_DATABASE_URL=postgresql://postgres:[TEST-PASSWORD]@db.<test-project-ref>.supabase.co:5432/postgres

# --- Local fallback (docker compose -f db/docker-compose.yml up -d) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yth_dev
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/yth_test

CORS_ORIGINS=http://localhost:5173
ENV=dev
